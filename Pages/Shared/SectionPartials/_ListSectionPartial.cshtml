@model ListSection

@{
    var listItems = Model.ListItems;
}

<section class="section-full @(Model.BackgroundColor ? "section-bg" : "")">
    <div class="container">
        <h3 class="text-green sci-fi-text">@Model.Heading</h3>
        @if (!string.IsNullOrWhiteSpace(Model.SubHeading))
        {
            <h3 class="text-green sci-fi-text">@Model.SubHeading</h3>
        }

        <ul class="striped-list pt-1 pb-1">
            @foreach (var li in listItems)
            {
                <li>@li.Text <i class="@li.Icon?.IconText"></i></li>
            }
        </ul>
    </div>
</section>
@if (Model.SpaceBottm)
{
    <div class="section-space"></div>
}