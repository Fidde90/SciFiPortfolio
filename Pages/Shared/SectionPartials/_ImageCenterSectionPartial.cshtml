@model ImageCenterSection

@{
    var paraTop = Model.ParagraphsTop;
    var desktopImages = Model.DesktopImages;
    var mobileImages = Model.MobileImages;
    var paraBottom = Model.ParagraphsBottom;
}

<section class="section-full @(!string.IsNullOrWhiteSpace(Model.BackgroundColor) ? $"{Model.BackgroundColor}" : "") @Model.Paddings">
    <div class="container">
        @if (!string.IsNullOrWhiteSpace(Model.Heading))
        {
            <h2 class="text-green text-sci-fi">@Model.Heading</h2>
        }
        @if (!string.IsNullOrWhiteSpace(Model.SubHeading))
        {
            <h3 class="text-green text-sci-fi">@Model.SubHeading</h3>
        }

        @foreach (var para in paraTop)
        {        
            <p>@para.Text</p>
        }

        @foreach (var image in desktopImages)
        {
            <img class="@(mobileImages.Any() ? "desktop-img" : "image-center-section-img")" src="~/@image.ImageUrl" alt="@image.AltText" />
        }
        @foreach (var image in mobileImages)
        {
            <img class="mobile-img" src="~/@image.ImageUrl" alt="@image.AltText" />
        }
        @foreach (var para in paraBottom)
        {
            <p>@para.Text</p>
        }
    </div>
</section>
@if (Model.SpaceBottom)
{
    <div class="section-space"></div>
}