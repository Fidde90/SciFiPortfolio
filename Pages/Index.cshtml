@page

@model IndexModel
@{
    var cards = Model.Vm.ProjectCards;
    var icons = Model.Vm.TechIconsSlider;
    var contentSections = Model.Vm.ContentSections;
}

<section class="hero container">
    <div class="mb-4 hero-text">
        <h1 class="mb-2">Fredrik Bengtsson</h1>
        <h1>Fullstack .Net utvecklare</h1>
    </div>

    <div class="mt-10">
        <div class="carousel">
            <div class="carousel-group">
                @foreach (var icon in icons)
                {
                    <img class="carousel-img" src="~/@icon.ImageUrl" alt="@icon.AltText" />
                }
            </div>
        </div>
    </div>
</section>

@foreach (var section in contentSections)
{
    @switch (section)
    {
        case TextContentSection textSection:
            {
                <section class="section-full @(textSection.BackgroundColor ? "section-bg" : "")">
                    <div class="container">

                        @foreach (var para in textSection.Paragraphs)
                        {
                            <p>
                                @para.Text
                            </p>
                        }

                    </div>
                </section>

                @if (textSection.SpaceBottm)
                {
                    <div class="section-space"></div>
                }

                break;
            }

        default:
            {
                <p>inget att visa</p>
                break;
            }
    }
}

<section class="project-cards container">
    @foreach (var card in cards)
    {
        <partial name="Shared/_ProjectCardPartial.cshtml" model="card" />
    }
</section>

<div class="section-space"></div>