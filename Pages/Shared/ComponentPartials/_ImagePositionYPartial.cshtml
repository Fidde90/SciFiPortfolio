@model ImageWithPositionSection
@{
    bool IsTopPosition = Model.ImagePosition.ToString() == "Top";
    bool hasMobileImage = !string.IsNullOrWhiteSpace(Model.MobileImage.ImageUrl);
}

@if (IsTopPosition)
{
    <div class="d-flex-column">
        <div class="text-center">
            <img asp-append-version="true" class="image-position-y @(hasMobileImage ? "desktop-img" : "")" src="~/@Model.DesktopImage.ImageUrl" alt="@Model.DesktopImage.AltText" />
            @if (hasMobileImage)
            {
                <img asp-append-version="true"  class="image-position-y mobile-img border-white" src="~/@Model.MobileImage.ImageUrl" alt="@Model.MobileImage.AltText" />
            }
        </div>
        <div>
            @foreach (var para in Model.Paragraphs)
            {
                <p>@para.Text</p>
            }
        </div>
    </div>
}
else
{
    <div class="d-flex-column">
        <div>
            @foreach (var para in Model.Paragraphs)
            {
                <p>@para.Text</p>
            }
        </div>
        <div>
            <img asp-append-version="true"  class="image-position-y @(hasMobileImage ? "desktop-img" : "") border-white" src="~/@Model.DesktopImage.ImageUrl" alt="@Model.DesktopImage.AltText" />
            @if (hasMobileImage)
            {
                <img asp-append-version="true" class="image-position-y mobile-img border-white" src="~/@Model.MobileImage.ImageUrl" alt="@Model.MobileImage.AltText" />
            }
        </div>
    </div>
}


