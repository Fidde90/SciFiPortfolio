@using Microsoft.Extensions.Options
@using SciFiPortfolio.Settings
@inject IOptions<CookieSettings> Cookies
@{
    var currentTheme = Context.Request.Cookies[Cookies.Value.Theme] ?? "sci-fi";
}

<div class="theme-selector-box">
    <p class="dropdown-link text-primary m-0">Tema: </p>
    <select class="theme-select" onchange="setTheme(this.value)">
        @foreach (var theme in ColorThemes.All)
        {
            <option value="@theme" selected="@(theme == currentTheme)">
                <p class="text-glow-@theme">@theme</p>  
            </option>
        }
    </select>
</div>