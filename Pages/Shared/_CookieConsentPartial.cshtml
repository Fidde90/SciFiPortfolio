@model string  

@{

}

<div id="cookie-banner" hidden data-consent-cookie="@Model">
    <div class="container">
        <p>
            Vi använder cookies för anonym besöksstatistik, ingen personlig data sparas. Det registreras enbart att
            någon har besökt hemsidan för att kunna se på ett ungefär hur många besökare man har haft.
        </p>

        <form method="post" action="/cookie-consent">
            @Html.AntiForgeryToken()
            <button id="cookie-accept" class="btn" type="submit" name="consent" value="accepted">Acceptera</button>
            <button id="cookie-decline" class="btn" type="submit" name="consent" value="declined">Neka</button>
        </form>
    </div>
</div> 
