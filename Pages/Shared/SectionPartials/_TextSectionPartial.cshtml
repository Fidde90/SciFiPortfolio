@model TextSection

@{

}

<section class="section-full @(!string.IsNullOrWhiteSpace(Model.BackgroundColor) ? $"{Model.BackgroundColor}" : "") @Model.Paddings">
    <div class="container">
    @if (!string.IsNullOrWhiteSpace(Model.Heading))
    {
            <h2 class="text-green text-sci-fi">@Model.Heading</h2>
        }
        @if (!string.IsNullOrWhiteSpace(Model.SubHeading))
        {
            <h3 class="text-green text-sci-fi">@Model.SubHeading</h3>
        }
        @foreach (var para in Model.Paragraphs)
        {
            <p>
                @para.Text
            </p>
        }
    </div>  
</section>
@if (Model.SpaceBottom)
{
    <div class="section-space"></div>
}