@page "/projects/vps-hosting-2"

@model ServerPage2Model
@{
    var page = Model.Vm.Page;
}

@foreach (var section in page.Sections)
{
    @switch (section)
    {
        case CardSection cardSection:
            {
                <partial name="/Pages/Shared/SectionPartials/_CardSectionPartial.cshtml" model="section" />
                break;
            }
        case CarouselSection:
            {
                <partial name="/Pages/Shared/SectionPartials/_CarouselSectionPartial.cshtml" model="section" />
                break;
            }
        case HeroSection heroSection:
            {
                <partial name="/Pages/Shared/SectionPartials/_HeroSectionPartial.cshtml" model="section" />
                <h1 class="text-center text-mega main-title gradient-text sci-fi-text">Serverarkitektur</h1>
                break;
            }
        case ImageCenterSection imageCenterSection:
            {
                <partial name="/Pages/Shared/SectionPartials/_ImageCenterSectionPartial.cshtml" model="section" />
                break;
            }
        case ImageSection imageSection:
            {
                <partial name="/Pages/Shared/SectionPartials/_ImageSectionPartial.cshtml" model="section" />
                break;
            }
        case ImageWithPositionSection imageWithPositionSection:
            {
                <partial name="/Pages/Shared/SectionPartials/_ImageWithPositionSectionPartial.cshtml" model="section" />
                break;
            }
        case ListSection listSection:
            {
                <partial name="/Pages/Shared/SectionPartials/_ListSectionPartial.cshtml" model="section" />
                break;
            }
        case TextSection textSection:
            {
                <partial name="/Pages/Shared/SectionPartials/_TextSectionPartial.cshtml" model="section" />
                break;
            }
        default:
            {
                <p>inget att visa</p>
                break;
            }
    }
}