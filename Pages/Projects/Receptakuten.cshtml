@page "/projects/receptakuten"

@model ReceptakutenModel
@{
}

@if (Model.Vm is not null && Model.Vm.Page is not null)
{
    @if (Model.Vm.Hero is not null)
    {
        <div class="section-space"></div>
        <partial name="/Pages/Shared/SectionPartials/_HeroSectionPartial.cshtml" model="Model.Vm.Hero" />
    }

    @if (Model.Vm.ShowTitle)
    {
        <h1 class="text-center text-mega main-title gradient-text text-sci-fi">@(Model.Vm.Page.Title)</h1>
    }

    <div class="container d-flex-wrap ">
        @foreach(var childPage in Model.Vm.Page.ChildPages)
        {
            <a href="/projects/@childPage.Slug" class="sci-fi-link green-link-xl text-center">Läs mer om @childPage.Title</a>
        }
    </div>

    <vc:Renderer sections="Model.Vm.Page.Sections" />
}