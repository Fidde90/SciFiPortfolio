@page "/projects/receptakuten"

@model ReceptakutenModel
@{
}

@if (Model.Vm is not null && Model.Vm.Page is not null)
{
    @if (Model.Vm.Hero is not null)
    {
        <div class="section-space"></div>
        <partial name="/Pages/Shared/SectionPartials/_HeroSectionPartial.cshtml" model="Model.Vm.Hero" />
    }

    @if (Model.Vm.ShowTitle)
    {
        <h1 class="text-center text-mega main-title gradient-text text-sci-fi">@(Model.Vm.Page.Title)</h1>
    }

    <div class="container links">
        @foreach(var childPage in Model.Vm.Page.ChildPages)
        {
            <a href="/projects/@childPage.Slug" class="page-link">Läs mer om @childPage.Title</a>
        }
    </div>

    <vc:Renderer sections="Model.Vm.Page.Sections" />
}

<style>

    .links{
        display:flex;
        gap:30px;
        justify-content:center;
        align-items:center;
    }

    a{
        text-decoration:underline;
        color: #22c55e;
        font-weight: var(--fw-bold);
        font-size:var(--text-xl);
    }

    .page-link::before {
        content: "";
        display: inline-block;
        height: 2px;
        width: 20px;
        background-color: #22c55e;
        transform: rotate(220deg);
        margin-bottom: 2px;
        margin-right: -2px;
    }

    .page-link::after   {
        content: "";
        display: inline-block;
        height: 2px;
        width: 20px;
        background-color: #22c55e;
        transform:rotate(140deg);
        margin-bottom:3px;
        margin-left:-2px;
       
    }

</style>