@model ImageSection

@{
    var desktopImages = Model.DesktopImages;
    var mobileImages = Model.MobileImages;
}

<section class="section-full @(!string.IsNullOrWhiteSpace(Model.BackgroundColorCss) ? $"{Model.BackgroundColorCss}" : "") @Model.PaddingsCss @Model.BordersCss">
    <div class="container">
        @if (!string.IsNullOrWhiteSpace(Model.Heading))
        {
            <h2 class="text-green text-sci-fi">@Model.Heading</h2>
        }
        @if (!string.IsNullOrWhiteSpace(Model.SubHeading))
        {
            <h3 class="text-green text-sci-fi">@Model.SubHeading</h3>
        }
        <div class="text-center">
            @foreach (var image in desktopImages)
            {
                <img asp-append-version="true" class="@(mobileImages.Any() ? "desktop-img" : "regular-img") border-white d-block" src="~/@image.ImageUrl" alt="@image.AltText" />
            }
            @if (mobileImages.Any())
            {
                @foreach (var image in mobileImages)
                {
                    <img asp-append-version="true"  class="mobile-img border-white" src="~/@image.ImageUrl" alt="@image.AltText" />
                }
            }
        </div>
    </div>  
</section>
@if (Model.SpaceBottom)
{
    <div class="section-space"></div>
}