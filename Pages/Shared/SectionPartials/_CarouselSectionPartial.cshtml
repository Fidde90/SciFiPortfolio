@model CarouselSection

@{
    var images = Model.Images;
}

@if (images.Any())
{
    <section class="slider-container container @(!string.IsNullOrWhiteSpace(Model.BackgroundColor) ? $"{Model.BackgroundColor}" : "") @Model.Paddings">
        <div class="carousel">
            <div class="carousel-group">
                @foreach (var image in images)
                {
                    <img class="carousel-img" src="~/@image.ImageUrl" alt="@image.AltText" />
                }
            </div>
        </div>
    </section>
    @if (Model.SpaceBottom)
    {
        <div class="section-space"></div>
    }
}
