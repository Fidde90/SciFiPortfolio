@model ImageWithPositionSection
@{
    var imageClass = Model.ImagePosition.ToString() == "Right" ? "image-postion-right" : "image-postion-left";
    bool mobileImage = !string.IsNullOrWhiteSpace(Model.MobileImage.ImageUrl);
}

<div class="text-position-x">
    <img asp-append-version="true"  class="@imageClass" src="~/@Model.DesktopImage.ImageUrl" alt="@Model.DesktopImage.AltText" />
    @foreach (var para in Model.Paragraphs)
    {
        <p>@para.Text</p>
    } 
</div>
