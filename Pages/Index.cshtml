@page

@model IndexModel
@{
    var page = Model.Vm.Page;
    var icons = Model.Vm.TechIconsSlider ?? [];
}

@foreach (var section in page.Sections)
{
    @switch (section)
    {
        case HeroSection heroSection:
            {
                <partial name="Shared/SectionPartials/_HeroSectionPartial.cshtml" model="section" />
                break;
            }
        case CarouselSection:
            {
                <partial name="Shared/SectionPartials/_CarouselSectionPartial.cshtml" model="section" />
                break;
            }
        case TextSection textSection:
        {
            <partial name="Shared/SectionPartials/_TextSectionPartial.cshtml" model="section"/>
            break;
        }

        case CardSection cardSection:
        {
            <partial name="Shared/SectionPartials/_CardSectionPartial.cshtml" model="section" />
            break;
        }

        default:
        {
            <p>inget att visa</p>
            break;
        }
    }
}

<div class="section-space"></div>