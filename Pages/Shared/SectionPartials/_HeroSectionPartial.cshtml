@model HeroSection

@{

}
<section class="section-full @(!string.IsNullOrWhiteSpace(Model.BackgroundColorCss) ? $"{Model.BackgroundColorCss}" : "") @Model.PaddingsCss @Model.BordersCss">
        @if (Model.Image is not null)
        {
            <div class="hero-image-@Model.HeroImageSizeCssClass">
                <div class="hero-img-container">
                <img asp-append-version="true"  src="~/@Model.Image.ImageUrl" alt="@Model.Image.AltText">
                </div>
            </div>
        }
        else
        {
            <div class="text-hero container">
                <div class="hero-text">
                    <h1 class="mb-2 text-@Model.TextColor">@Model.Heading</h1>
                    <h1 class="text-@Model.TextColor">@Model.SubHeading</h1>
                </div>
            </div>          
        }
</section> 
@if (Model.SpaceBottom)
{
    <div class="section-space"></div>
}
