@inject IOptions<CookieSettings> Cookies

@{
    var theme = Context.Request.Cookies[Cookies.Value.Theme];
    var consentCookieName = Cookies.Value.Consent;
    if (!ColorThemes.All.Contains(theme))
    {
        theme = "sci-fi";
    }
}

<!DOCTYPE html>
<html lang="en" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfolio för Fredrik Bengtsson, .NET-utvecklare med fokus på ASP.NET Core, C#, Docker och moderna webbapplikationer.">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
          integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet">
    <script defer src="~/js/site.js" asp-append-version="true"></script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <partial name="_SpacePartial.cshtml" />
    <partial name="_SpacewallsPartial.cshtml" />

    <div class="nav-shadow"></div>
    <div class="wrapper">       
        <header>
            <div class="nav-bars">
                <partial name="_HeaderPartial.cshtml" />
            </div>
        </header>
      
        <div class="">
            <main role="main" class="">
                @RenderBody()
            </main>
        </div>

        <footer class="pb-1">
            <div class="container d-flex-between">
                <div>
                    <p class="m-0 text-s">Uppdaterad senast: @(DateTime.UtcNow.ToShortDateString())</p>
                    <p class="text-s">Kontakt: fredrik.t.bengtsson@hotmail.com</p>
                </div>
                <button id="cookie-settings-btn" class="m-0 link-btn" typeof="button">Hantera cookies</button>
            </div>
        </footer> 
  
    </div>

    <partial name="_CookieConsentPartial" model="@consentCookieName" />

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>