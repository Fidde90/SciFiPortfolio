@inject IRendererService renderer

@model IEnumerable<ContentSection>
@{
   
}

@if (Model is not null && Model.Any())
{
    <article>
        @foreach (var section in Model)
        {
            var partial = renderer.GetPartial(section);

            if (partial is not null)
            {
                <partial name="@partial" model="section" />
            }
        }
    </article>  
}